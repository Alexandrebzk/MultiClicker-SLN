<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MultiClicker</RootNamespace>
    <AssemblyName>MultiClicker</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>auto-clicker-app-logo.ico</ApplicationIcon>
    <Product>MultiClicker</Product>
    <AssemblyTitle>Multi-Clicker</AssemblyTitle>
    <Copyright>Copyright © 2024</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <SatelliteResourceLanguages>en;fr;es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tesseract.Drawing" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UI\MultiClickerForm.Designer.cs">
      <DependentUpon>MultiClickerForm.cs</DependentUpon>
    </Compile>
    <Compile Update="UI\PositionConfigurationForm.Designer.cs">
      <DependentUpon>PositionConfigurationForm.cs</DependentUpon>
    </Compile>
    <Compile Update="UI\PositionOverlayForm.Designer.cs">
      <DependentUpon>PositionOverlayForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Strings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Strings.fr.resx">
      <DependentUpon>Strings.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Strings.es.resx">
      <DependentUpon>Strings.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="mandatory_assets\tessdata\eng.traineddata">
      <Link>tessdata\eng.traineddata</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="mandatory_assets\tessdata\fra.traineddata">
      <Link>tessdata\fra.traineddata</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyCosmetics" AfterTargets="AfterBuild">
    <ItemGroup>
      <CosmeticsFiles Include="$(ProjectDir)mandatory_assets\cosmetics\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(CosmeticsFiles)" DestinationFolder="$(OutDir)cosmetics" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCosmeticsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <CosmeticsFiles Include="$(ProjectDir)mandatory_assets\cosmetics\*.png" />
      <TessdataFiles Include="$(ProjectDir)mandatory_assets\tessdata\*.traineddata" />
    </ItemGroup>
    <Copy SourceFiles="@(CosmeticsFiles)" DestinationFolder="$(PublishDir)cosmetics" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TessdataFiles)" DestinationFolder="$(PublishDir)tessdata" SkipUnchangedFiles="true" />
  </Target>

</Project>
